# Copy to apps/web/.env.local and fill in. Never commit real values.
# All values below are fictitious placeholders.

# --- Public (exposed to the browser) ---------------------------------------

# Public URL of the web app. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base of the permanent QR code link. QR codes encode this value + the event code,
# so it must never change once codes are printed (SPEC 6.2 bis).
# Local: same as the site URL. Production: the final short domain.
NEXT_PUBLIC_SHORT_LINK_BASE=http://localhost:3000

# Supabase > Project Settings > API. Locally, `pnpm db:start` then `pnpm exec supabase status -o env`
# prints ANON_KEY and SERVICE_ROLE_KEY (public development keys, safe to use locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key

# "true" shows the "Continue with Google" button. Set it once Google is enabled in Supabase
# (Authentication > Providers > Google). Leave empty or "false" until then.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Cloudflare dashboard > Turnstile > your widget > site key. Empty = no invisible robot check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry > Project Settings > Client Keys (DSN). Leave empty locally.
NEXT_PUBLIC_SENTRY_DSN=
# Label shown in Sentry (production, preview...). Optional.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Sentry > Settings > Developer Settings > Organization Tokens. Build time only (Vercel), never in Git.
# When set, production builds upload source maps so stack traces are readable.
SENTRY_AUTH_TOKEN=

# PostHog > Project settings > Project API key (EU region). Loaded only after consent.
NEXT_PUBLIC_POSTHOG_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) --------------------------

# Supabase > Project Settings > API > service_role key. Bypasses RLS: server code only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Random string (16+ characters) protecting the scheduled-task routes (phase 4).
CRON_SECRET=

# Cloudflare R2 (phase 2): account ID, API token (Object Read & Write), bucket name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# "eu" (default) for a bucket created in the EU jurisdiction, "default" otherwise.
R2_JURISDICTION=
# Leave empty on Vercel. Only to use a local S3 emulator instead of R2 (see docs/setup.md).
R2_ENDPOINT=

# Upstash Redis > REST API. Used for rate limiting (S-003). Empty = per-instance fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile secret key. Set together with the site key above, or neither.
TURNSTILE_SECRET_KEY=

# Resend > API Keys (phase 1).
RESEND_API_KEY=

# Stripe > Developers > API keys. TEST MODE ONLY: keys must start with sk_test_ (phase 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
