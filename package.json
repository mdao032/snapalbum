{
  "name": "snapalbum",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:load": "echo \"Tests de charge k6 : ajoutés en phase 2\" && exit 0",
    "db:migrate": "supabase db push",
    "db:types": "node scripts/db-types.mjs",
    "fixtures:make": "node scripts/make-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:db": "turbo run test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "storage:start": "node scripts/storage-emulator.mjs start",
    "storage:stop": "node scripts/storage-emulator.mjs stop",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@snapalbum/config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.121.0",
    "turbo": "2.11.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,yml,yaml}": "prettier --write",
    "*.md": "prettier --write"
  }
}
